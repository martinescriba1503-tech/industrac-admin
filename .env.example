# Supabase (Configurar en Vercel y .env.local - NO exponer SERVICE_ROLE_KEY en el cliente)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud / Google APIs (Solo servidor - Drive y Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_CALENDAR_ID=

# Integración futura con sistema actual de Reportes Técnicos (opcional)
TECHNICAL_REPORTS_WEBHOOK_SECRET=

# URL base de la aplicación (usada para enlaces en Google Calendar)
NEXT_PUBLIC_APP_URL=http://localhost:3000
